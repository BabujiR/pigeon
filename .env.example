# Copy to .env (git-ignored) only if you need to change these.

# Host port for Postgres. Use 5433 if a Postgres already runs on your machine,
# and set the same value as an environment variable when starting the app.
PIGEON_DB_PORT=5432

# Only needed if you change the LocalStack image from 4.14 to a newer tag.
# Create a free Hobby account at localstack.cloud and paste its auth token here.
LOCALSTACK_AUTH_TOKEN=
